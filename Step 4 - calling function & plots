%main function for step 4

% finding total flowrate [mol/s] given inlet mass flowrate [kg/s].
m_flowrate = 0.001;
nT0 = (m_flowrate)/(y0_CH3OH*Mr_CH3OH+y0_O2*Mr_O2+y0_H2O*Mr_H2O+y0_N2*Mr_N2);

n0_CH3OH = y0_CH3OH*nT0; 
n0_O2 = y0_O2*nT0;
n0_H2O = y0_H2O*nT0;
n0_HCHO = y0_HCHO*nT0; 
n0_CO = y0_CO*nT0;
n0_N2 = y0_N2*nT0;
extent_1 = 0;
extent_2 = 0;
P_0 = 1.6; %in bar (pascal conversion in the ode function)

F0 = [n0_CH3OH, n0_O2, n0_HCHO, n0_H2O, n0_CO, n0_N2,extent_1,extent_2,P_0];


% Create anonymous function that passes m_flowrate to step3_reactor
reactor_ode = @(t, F) step4_reactor(t, F, m_flowrate);

% Solve the ODE using ode15s (stiff solver)
options = odeset('RelTol', 1e-6, 'AbsTol', 1e-9);
[z_points, F_values] = ode45(reactor_ode, [0 2], F0, options);
F_values = F_values';  % Transpose to match your indexing (rows = variables, cols = points)



F_CH3OH = F_values(1, :);
F_O2 = F_values(2, :);
F_HCHO = F_values(3, :);
F_H2O = F_values(4, :);
F_CO = F_values(5, :);
F_N2 = F_values(6, :);

% Plot
figure("Name","Molar Flowrate of Species Across the Reactor");
plot(z_points, F_CH3OH, 'b-', 'LineWidth', 2); hold on;
plot(z_points, F_O2, 'r-', 'LineWidth', 2);
plot(z_points, F_HCHO, 'g-', 'LineWidth', 2);
plot(z_points, F_H2O, 'c-', 'LineWidth', 2);
plot(z_points, F_CO, 'm-', 'LineWidth', 2);
xlabel('Reactor Length (m)');
ylabel('Molar Flow Rate (mol/s)');
legend('CH3OH', 'O2', 'HCHO', 'H2O', 'CO');
title("Molar Flowrate of Species Across the Reactor")

figure("Name","Extent Of reaction")
extent1 = F_values(7,:);
extent2 = F_values(8,:);
plot(z_points, extent1, 'b-', 'LineWidth', 2); hold on;
plot(z_points, extent2, 'r-', 'LineWidth', 2);
title('Extent Of reaction');
legend("Reaction 1","Reaction 2")

P = F_values(9,:);
figure("Name","Pressure Drop Across Reactor")
plot(z_points, P,'LineWidth',2)
xlabel('Reactor Length (m)');
ylabel('Pressure (atm)');
title("Pressure Drop Across Reactor")
