eqn2_HCHO_order = (eqn2_HCHO_order_290+eqn2_HCHO_order_250)/2
eqn2_O2_order = (eqn2_O2_order_250 + eqn2_O2_order_290)/2
%------------------------------------------------------------
%-----------------------250 degrees--------------------------
T = 250 + 273.15;
%------------------------------------------------------
%Concentration of HCHO vs Rate of CO
%using rate equation to plot (data set a)
k2_250c = 2.36943E-05;
figure("Name","Concentration of HCHO vs Rate of CO")
