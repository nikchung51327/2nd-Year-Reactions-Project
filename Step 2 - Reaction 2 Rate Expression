plot(ln_O2_b_250, y_values, 'r-','LineWidth',1.5);
legend('Data Points', 'Linear Fit');
title("3.5% Formalaldehyde, ln(O2) vs ln(rate of CO) at 250C")
%R^2 value 
mdl = fitlm(y_values,ln_R_CO_b_250);           % X predictors, y response
eqn2_b_250_rsquared = mdl.Rsquared.Ordinary

eqn2_HCHO_order_250 = coeff_a(1)
eqn2_O2_order_250 = coeff_b(1)

