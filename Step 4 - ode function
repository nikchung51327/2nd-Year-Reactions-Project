function dni_dz = step4_reactor(t,F)

% ADD THIS CHECK AT THE VERY BEGINNING:
if F(9) <= 0.01  % If pressure too low
    fprintf('WARNING: Pressure too low at z=%.2f, P=%.4f\n', t, F(9));
    dni_dz = zeros(9,1);
    return;
end

% Check for negative molar flows
if any(F(1:6) < 0)
    fprintf('WARNING: Negative flows at z=%.2f\n', t);
    dni_dz = zeros(9,1);
    return;
end


%parameters
rho_cat = 1500; %kg m^-3
bed_voidage = 0.4;
%temperature
T = 523;
%mass flowrate
m_flowrate = 0.001; %kg.s-1
%
R = 8.314;
D_p = 7.04 *10^-3;
%alpha
alpha = 0.44;
% Molar masses of each component kg.mol-1
Mr_CH3OH = 32.042e-3;
Mr_O2 = 32.00e-3;
Mr_HCHO = 30.026e-3;
Mr_H2O = 18.00e-3;
Mr_CO = 28e-3;
Mr_N2 = 28.014e-3;

% tube diameter [m]; 
tube_diameter = 20 * 10^-3;

A = pi*(tube_diameter/2)^2;

%G (superficial mass velocity)
G = m_flowrate/A;  %superficial mass velocity of the fluid

%defining each variable 
n_CH3OH = F(1);
n_O2 = F(2);
n_HCHO = F(3);
n_H2O = F(4);
n_CO = F(5);
n_N2 = F(6);
extent_1 = F(7);
extent_2 = F(8);
P = F(9);
P_pascal = P * 101325; % Convert pressure from atm to pascal

%partial pressures 
P_CH3OH = n_CH3OH / (n_CH3OH + n_O2 + n_HCHO + n_H2O + n_CO + n_N2) * P; 
P_O2 = n_O2 / (n_CH3OH + n_O2 + n_HCHO + n_H2O + n_CO + n_N2) * P; 
P_H20 = n_H2O / (n_CH3OH + n_O2 + n_HCHO + n_H2O + n_CO + n_N2) * P; 
P_HCHO = n_HCHO / (n_CH3OH + n_O2 + n_HCHO + n_H2O + n_CO + n_N2) * P;

%total molar flowrate
n_T = n_CH3OH + n_O2 + n_HCHO + n_H2O + n_CO + n_N2;

% Defining Composition of components

x_ch3oh = n_CH3OH/n_T;
x_o2 = n_O2/n_T;
x_hcho = n_HCHO/n_T;
x_h2o = n_H2O/n_T;
x_co = n_CO/n_T;
x_n2 = n_N2/n_T;

Mr_total = x_ch3oh*Mr_CH3OH + x_o2*Mr_O2 + x_hcho*Mr_HCHO + x_h2o*Mr_H2O + x_co*Mr_CO + x_n2*Mr_N2;

rho_mix = (P_pascal*Mr_total)/(R*T);


dw_dz = rho_cat*(1-bed_voidage)*A;

[r1 r2] = rates_LHHW(T, alpha, P_CH3OH, P_O2, P_H20, P_HCHO);
dn_CH3OH_dz = -r1*dw_dz;
dn_O2_dz = -(r1+r2)/2*dw_dz;
dn_HCHO_dz = (r1-r2)*dw_dz;
dn_H2O_dz = (r1+r2)*dw_dz; 
dn_CO_dz = r2*dw_dz; 
dn_N2_dz = 0; % Assuming no change in N2 concentration
d_extent1_dz = A*r1;
d_extent2_dz = A*r2;
dP_dz = -(1.75*(G^2)*(1-bed_voidage))/(D_p*rho_mix*(bed_voidage)^3);
dP_dz = dP_dz / 101325;  % <--- ADD THIS LINE to convert Pa/m to atm/m
dni_dz = [dn_CH3OH_dz; dn_O2_dz; dn_HCHO_dz; dn_H2O_dz; dn_CO_dz; dn_N2_dz; d_extent1_dz; d_extent2_dz; dP_dz];

% ADD THESE DIAGNOSTIC LINES:
if mod(round(t*10), 100) == 0  % Print every ~1 m
    fprintf('z=%.2f: P=%.4f atm, rho=%.3f kg/m3, dP/dz=%.2e atm/m, G=%.2f\n', ...
            t, F(9), rho_mix, dP_dz, G);
end 
end 

